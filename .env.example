# No environment file is needed for the LOCAL demo.
# For a public Vercel design preview, explicitly set DEMO_MODE=true.
# Demo data is temporary and must not be used for real members.
DEMO_MODE=true
# For real accounts, set DEMO_MODE=false and supply a PostgreSQL connection:
DATABASE_URL=
# Set APP_URL to your exact deployed origin, no trailing slash.
APP_URL=http://localhost:3000
# Used only by the one-time db:setup script. Choose your own credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Deadline and bonus values are managed in the admin settings page.
